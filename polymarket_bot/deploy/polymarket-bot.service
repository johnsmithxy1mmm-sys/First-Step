# Systemd unit: the bot runs 24/7 and survives crashes and server reboots.
#
# Install (adjust the paths for yourself):
#   sudo cp polymarket_bot/deploy/polymarket-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now polymarket-bot      # autostart + start now
#
# Management:
#   systemctl status polymarket-bot                 # status
#   journalctl -u polymarket-bot -f                 # live logs
#   sudo systemctl stop polymarket-bot              # STOP (only you)
#   sudo systemctl disable polymarket-bot           # remove from autostart

[Unit]
Description=Polymarket Longshot Bot (tail mispricing barbell)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A separate unprivileged user (create: sudo useradd -r -m polybot)
User=polybot
WorkingDirectory=/opt/Polymarket-Mint-Bot
# Secrets from .env; the file must be owned by polybot with mode 600.
EnvironmentFile=/opt/Polymarket-Mint-Bot/polymarket_bot/.env
# To test without money, replace "--mode live --i-understand-the-risk" with "--mode dry-run".
ExecStart=/opt/Polymarket-Mint-Bot/.venv/bin/python -m polymarket_bot --mode live --i-understand-the-risk
Restart=always
RestartSec=30
# If the bot crashes 5 times in 10 minutes — stop and do not hammer the exchange.
StartLimitIntervalSec=600
StartLimitBurst=5
# Limits just in case.
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
