# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env в git.

# --- Кошелёк Polygon (только для --mode live) ---
POLYMARKET_PRIVATE_KEY=0x...
# Адрес депозита (прокси-кошелёк) — обязателен для аккаунтов через email/браузер:
POLYMARKET_FUNDER=0x...
# 0 = свой EOA, 1 = email (Magic), 2 = браузерный кошелёк
POLYMARKET_SIGNATURE_TYPE=0

# --- LLM-сигнал (опционально, estimator.llm.enabled: true) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram-алерты (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
