# Copy to .env and fill in. NEVER commit .env to git.

# --- Polygon wallet (only for --mode live) ---
POLYMARKET_PRIVATE_KEY=0x...
# Deposit address (proxy wallet) — required for email/browser accounts:
POLYMARKET_FUNDER=0x...
# 0 = your own EOA, 1 = email (Magic), 2 = browser wallet
POLYMARKET_SIGNATURE_TYPE=0

# --- Polygon RPC (only for redemption.execute: true — auto-claim winnings) ---
# Any Polygon mainnet endpoint: public, Alchemy, Infura, QuickNode...
POLYGON_RPC_URL=

# --- LLM signal (optional, estimator.llm.enabled: true) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
