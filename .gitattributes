# Общая нормализация текста (должна идти ПЕРВОЙ — частные правила ниже её
# перекрывают, так как в gitattributes побеждает последнее совпадение).
* text=auto

# Шрифты — бинарные.
*.ttf binary

# Windows batch-файлы храним как есть, с окончаниями CRLF: иначе cmd.exe не
# находит метки (call/goto). «-text» отключает любую нормализацию переводов строк.
*.bat -text
