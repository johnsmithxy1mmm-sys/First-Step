# Node backend — the only consumer of the risk engine, and the sole place
# the §6 degradation contract is enforced.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.backend -t hl-risk/backend .
FROM node:22-slim AS build

WORKDIR /srv
COPY services/backend/package.json services/backend/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY services/backend/tsconfig.json ./
COPY services/backend/src/ ./src/
RUN npx tsc -p tsconfig.json


FROM node:22-slim

WORKDIR /srv
COPY services/backend/package.json services/backend/package-lock.json* ./
# Production deps only: tsx, vitest and typescript are build-time tools and
# have no business in a running image.
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

COPY --from=build /srv/dist ./dist

USER node
ENV NODE_ENV=production \
    PORT=8080 \
    RISK_SERVICE_URL=http://engine:8787

EXPOSE 8080

# §6 lives here, so "the backend is up" and "the backend can answer" are
# different questions. This asks the first; the second is what /api/health
# reports to the frontend, and it stays 200 during an engine outage by
# design — an outage is a state the contract describes, not a crash.
# Probes the container's own HOSTNAME, not 127.0.0.1 — so a loopback-only
# bind FAILS this check instead of passing it.
#
# The 127.0.0.1 version reported `healthy` for a backend bound to loopback,
# which is reachable from inside the container and from nowhere else: every
# request from `web` got ECONNREFUSED while compose showed three green
# services. A healthcheck that can pass while every real client fails is
# worse than no healthcheck, because it is believed.
#
# `hostname` inside a compose container resolves on the compose network, so
# this reaches the service the same way a client does. It stays a
# self-contained probe with no extra tooling: still one `node -e`, still no
# curl or wget in the image (neither is present — `wget` is what an operator
# reaches for first and it is not there).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://'+require('os').hostname()+':'+(process.env.PORT||8080)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
