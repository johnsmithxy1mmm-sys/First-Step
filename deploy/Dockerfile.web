# Next.js frontend — one screen, four widgets, read-only.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.web -t hl-risk/web .
FROM node:22-slim AS build

WORKDIR /srv
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY apps/web/ ./

# `rewrites()` in next.config.mjs is evaluated when the route manifest is
# built, not when the server starts, so BACKEND_URL is a build argument here
# rather than a runtime variable. Under compose the value is the service name
# and never changes; pointing at a different backend means a rebuild, which
# is worth saying out loud because the equivalent env var on the other two
# images *is* read at runtime and the asymmetry would otherwise surprise.
ARG BACKEND_URL=http://backend:8080
ENV BACKEND_URL=${BACKEND_URL}
RUN npm run build


FROM node:22-slim

WORKDIR /srv
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# The standalone bundle carries its own minimal node_modules; static/ is not
# included in it and has to come across separately. There is no public/ in
# this app — add the copy if one appears, because standalone will not.
COPY --from=build /srv/.next/standalone ./
COPY --from=build /srv/.next/static ./.next/static

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
