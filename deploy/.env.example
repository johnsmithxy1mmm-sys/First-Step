# Copy to deploy/.env and fill in. deploy/.env is gitignored.
#
#   cp deploy/.env.example deploy/.env
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'   # for the token

# Shared secret between the backend and the engine. The engine refuses to
# bind anything but loopback without it, so there is no "forgot to set it"
# path that ends in an exposed engine — it ends in a container that will not
# start, which is the failure you want.
RISK_SERVICE_TOKEN=

# Calibration journal (§3.4).
POSTGRES_PASSWORD=
POSTGRES_USER=risk
POSTGRES_DB=shadow

# --fixture runs the whole stack on a synthetic market: it exercises every
# moving part, validates nothing, and labels itself as synthetic everywhere
# it could be mistaken for real. --live needs api.hyperliquid.xyz reachable,
# and every §5.1 parser is still unverified against a live response
# (OPEN-QUESTIONS E5) — run `python -m risk_engine.market.verify` first.
ENGINE_MODE=--fixture

# Arguments for both shadow jobs. Live runs need an address list with a
# stated sampling frame (OPEN-QUESTIONS B4):
#   SHADOW_ARGS=--addresses /app/addresses.json
SHADOW_ARGS=--fixture

# Snapshot once a day; resolve hourly, because a prediction resolved late is
# marked stale and dropped from the gate (audit A-04).
SHADOW_INTERVAL_S=86400
RESOLVE_INTERVAL_S=3600

# Threads for the path blocks. 2 measured best on the build hardware; it is
# hardware-dependent and 4 measured *slower* on the real workload (D7).
RISK_ENGINE_WORKERS=2

WEB_PORT=3000
